{
  "functions": {
    "api/share.js": {
      "includeFiles": "{index.html,jobs.js,companies.js}"
    },
    "api/og.js": {
      "includeFiles": "{jobs.js,companies.js,logos/**}"
    },
    "api/profile-share.js": {
      "includeFiles": "profile.html"
    },
    "api/company-search.js": {
      "includeFiles": "companies.js"
    },
    "api/company-stats.js": {
      "includeFiles": "companies.js"
    },
    "api/resume-refine.js": {
      "includeFiles": "{jobs.js,companies.js,career-model.js}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/profile\\.html$",
      "dest": "/api/profile-share"
    },
    {
      "src": "^/$",
      "dest": "/api/share"
    },
    {
      "handle": "filesystem"
    }
  ]
}
